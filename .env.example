# Copy to .env.local (git-ignored) on a developer machine. In production these live in Vercel's project settings.
# Supabase project gpric-portal: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only, never NEXT_PUBLIC. Supabase service role (secret) key, used by the team invites and the Zeffy sync and webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Zeffy API key (Zeffy > Settings > Integrations). Used by /api/zeffy/sync to pull payments.
ZEFFY_API_KEY=
# A long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" when it runs the daily crons (Zeffy sync, email alerts).
CRON_SECRET=
# A long random string shared with Zeffy's webhook settings; sent as the x-zeffy-secret header or ?secret= on /api/zeffy/webhook.
ZEFFY_WEBHOOK_SECRET=

# Email alerts (0013_email_alerts.sql). Both empty = alerts switched off: filings queue in email_outbox and nothing is sent.
# Resend API key (resend.com > API Keys) and a sender on a domain verified in Resend, e.g. GPRIC Portal <alerts@example.org>.
RESEND_API_KEY=
EMAIL_FROM=
